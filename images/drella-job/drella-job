#!/usr/bin/env bash
# Drella job wrapper [21]. Runs inside the job pod:
#   1. with a repo (DRELLA_REPO): clones it with the GitHub credential (/creds/github).
#      Without one: starts in an empty working directory;
#   2. checks the model endpoint and writes OpenCode's config, both rendered by Drella
#      for the job's model (DRELLA_PREFLIGHT_*, DRELLA_OPENCODE_CONFIG; docs/v0.2.md);
#   3. runs `opencode run` with the prompt and standing instructions: with a repo,
#      work on a branch, push it and open a PR with gh; without one, write results to /out;
#   4. collects /out (transcript, plus diff and PR URL for a repo job);
#   5. reports the final status with the job-scoped token, then uploads /out to the
#      Drella API. A repo job succeeds only if a PR exists; a job without a repo
#      succeeds if the agent exits cleanly and wrote at least one output.
#
# Time limits (docs/v0.md): the agent runs under a timer that stops it
# DRELLA_AGENT_GRACE seconds before DRELLA_DEADLINE (the Job's hard limit). If the pod
# is told to stop (TERM), the agent is stopped too. Either way, everything after the
# agent shares whatever time is left: until the deadline, or until the pod's grace
# period (DRELLA_TERM_GRACE) ends. If the job has already failed when the agent ends
# (stopped, out of time, killed), that status is reported straight away, before
# step 4. Step 4 stops RESERVE seconds early, leaving the final status that long to
# reach the Drella API (less if the provisional report used it up).
set -uo pipefail

: "${DRELLA_API_URL:?}" "${DRELLA_JOB_ID:?}" "${DRELLA_JOB_TOKEN:?}"
: "${DRELLA_OPENCODE_CONFIG:?}" "${DRELLA_PREFLIGHT_URL:?}" "${DRELLA_PROMPT:?}"
MODEL_LABEL=${DRELLA_MODEL_LABEL:-$DRELLA_PREFLIGHT_URL}
OUT=${DRELLA_OUT:-/out}
WORK=${DRELLA_WORK:-/work}
CREDS=${DRELLA_CREDS:-/creds}
REPO=${DRELLA_REPO:-}
BRANCH="drella/${DRELLA_JOB_ID:0:8}"
STARTED=$(date -u +%Y-%m-%dT%H:%M:%SZ)
NOW=$(date +%s)
DEADLINE=${DRELLA_DEADLINE:-$((NOW + 3600))}
AGENT_GRACE=${DRELLA_AGENT_GRACE:-300}
TERM_GRACE=${DRELLA_TERM_GRACE:-120}
MARGIN=10   # stop this long before being killed
RESERVE=30  # step 4 leaves this long for the final status report

# Everything has to be done by FINISH_BY: the hard deadline, or the end of the grace
# period once the pod has been told to stop.
FINISH_BY=$((DEADLINE - MARGIN))
left() { echo $((FINISH_BY - $(date +%s))); }
# within MAX CMD...: run a step-4 command for at most MAX seconds, and never into the
# time reserved for the final status report.
within() {
  local t
  t=$(($(left) - RESERVE))
  [ "$t" -gt "$1" ] && t=$1
  [ "$t" -ge 1 ] || return 124
  shift
  timeout --kill-after=2 "$t" "$@"
}

log() { echo "[drella] $*"; }

# Calls to the Drella API. Drella may be restarting (e.g. an upgrade), so retry,
# including refused connections, for as long as there's time left. The calls are
# idempotent.
api() {
  local t
  t=$(left)
  [ "$t" -ge 5 ] || { log "no time left to call the Drella API"; return 1; }
  timeout "$t" curl -fsS --retry 1000 --retry-delay 5 --retry-max-time "$t" \
    --retry-connrefused -m 120 -H "Authorization: Bearer $DRELLA_JOB_TOKEN" "$@"
}

# Replace the job's secrets (the model's API key and the GitHub token) with
# [redacted] in a stream, line by line. The agent can read both from its environment;
# this keeps them out of the transcript, the session record and the archived log if it
# prints them. Best effort: a secret split across lines, or encoded, gets through, and
# so does anything the agent writes to other files in /out, sends to the Drella API
# with the job token, or writes straight to the pod's log (docs/v0.2.md#security).
# Values come from ENVIRON and are matched as fixed strings, so any character is safe.
# A single huge line full of secrets is slow to filter (each match copies the rest of
# the line); only an agent printing them on purpose produces that.
redact() {
  awk 'BEGIN {
      n = 0
      if (length(ENVIRON["DRELLA_LLM_KEY"]) >= 8) k[++n] = ENVIRON["DRELLA_LLM_KEY"]
      if (length(ENVIRON["GH_TOKEN"]) >= 8) k[++n] = ENVIRON["GH_TOKEN"]
    }
    {
      line = $0
      for (i = 1; i <= n; i++) {
        out = ""
        while ((p = index(line, k[i])) > 0) {
          out = out substr(line, 1, p - 1) "[redacted]"
          line = substr(line, p + length(k[i]))
        }
        line = out line
      }
      print line
      fflush()
    }'
}

# An output is a regular file (not a symlink) at the top level of /out whose name
# Drella accepts (letters, digits, ".", "_", "-"; not starting with "."). Nothing else
# is uploaded.
is_output() {
  [ -f "$1" ] && [ ! -L "$1" ] && [[ ${1##*/} =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]]
}

upload_outputs() {
  local f
  # Most useful first, in case time runs out.
  for f in "$OUT/pr-url.txt" "$OUT/diff.patch" "$OUT/transcript.txt" "$OUT"/*; do
    is_output "$f" || continue
    case " $uploaded " in *" $f "*) continue ;; esac
    uploaded="$uploaded $f"
    log "uploading $(basename "$f")"
    api -T "$f" "$DRELLA_API_URL/jobs/$DRELLA_JOB_ID/outputs/$(basename "$f")" \
      || log "upload of $(basename "$f") failed"
  done
}

# report STATUS MESSAGE: tell Drella the job's status. Drella keeps the latest report
# while the job runs, so a provisional status can be replaced by a final one.
report() {
  log "$1: $2"
  api -X POST -H 'Content-Type: application/json' \
    -d "$(jq -n --arg s "$1" --arg m "$2" '{status: $s, message: $m}')" \
    "$DRELLA_API_URL/jobs/$DRELLA_JOB_ID/status" \
    || log "reporting status failed"
}

# finish STATUS MESSAGE: report, upload outputs, exit. The status goes first: it
# matters most, and Drella accepts outputs until the pod has exited.
uploaded=""
finish() {
  phase=finishing
  report "$1" "$2"
  upload_outputs
  [ "$1" = succeeded ]
  exit
}

# Where the wrapper is: setup (steps 1-2), agent (3), collect (4), finishing (5).
phase=setup agent_pid="" stopped=""
# Told to stop (pod deleted, evicted, node drained). The pod is killed when its grace
# period ends, so everything left has to fit in it.
on_term() {
  [ -n "$stopped" ] && return
  stopped=1
  local by=$(($(date +%s) + TERM_GRACE - MARGIN))
  [ "$by" -lt "$FINISH_BY" ] && FINISH_BY=$by
  log "told to stop during $phase; finishing within $(left)s"
  case $phase in
    setup) finish failed "the job was stopped before the agent started" ;;
    # Stop the agent. If its pid isn't known yet, that happens as soon as it is.
    agent) [ -n "$agent_pid" ] && kill -TERM "$agent_pid" 2>/dev/null ;;
    # collect, finishing: carry on within the shorter time; the result says "stopped".
  esac
}
trap on_term TERM INT

# -- 1. workspace -------------------------------------------------------------

export GH_PROMPT_DISABLED=1 GIT_TERMINAL_PROMPT=0
if [ -s "$CREDS/github" ]; then
  export GH_TOKEN
  GH_TOKEN=$(<"$CREDS/github")
  # git authenticates with the same token, for the clone and the agent's pushes, and
  # only to https://github.com: never to another host (a submodule, a git dependency)
  # or over plain http.
  git config --global credential.https://github.com.helper \
    '!f() { echo username=x-access-token; echo "password=$GH_TOKEN"; }; f'
  if user=$(gh api user --jq '"\(.login) \(.id)"' 2>/dev/null); then
    read -r login id <<<"$user"
    git config --global user.name "$login"
    git config --global user.email "$id+$login@users.noreply.github.com"
  fi
fi
git config --global user.name >/dev/null || git config --global user.name "Drella agent"
git config --global user.email >/dev/null || git config --global user.email "drella@users.noreply.github.com"

if [ -n "$REPO" ]; then
  [ -s "$CREDS/github" ] || finish failed "a job with a repo needs a github credential"
  log "cloning $REPO"
  git clone "https://github.com/$REPO.git" "$WORK/repo" || finish failed "clone failed"
  cd "$WORK/repo" || finish failed "no checkout"
  BASE=$(git rev-parse HEAD)
  DEFAULT_BRANCH=$(git branch --show-current)
else
  mkdir -p "$WORK/space" && cd "$WORK/space" || finish failed "no working directory"
fi

# -- 2. configure OpenCode -----------------------------------------------------

# OpenCode retries an unreachable endpoint until the job times out, so check first.
# Drella's adapter for the model says what to call and with which headers; header
# values refer to the API key as {key}. The headers go through a private file, so the
# key isn't on curl's command line.
headers="$WORK/preflight-headers"
(umask 077; : >"$headers")
while IFS= read -r h; do
  # The replacement is quoted, so "&" in a key isn't expanded (bash 5.2 patsub).
  [ -n "$h" ] && printf '%s\n' "${h//'{key}'/"${DRELLA_LLM_KEY:-}"}" >>"$headers"
done <<<"${DRELLA_PREFLIGHT_HEADERS:-}"
# -g: the URL is used as is ("[" and "]" are never ranges).
code=$(curl -gsS -m 20 -o /dev/null -w '%{http_code}' -H @"$headers" "$DRELLA_PREFLIGHT_URL")
rm -f "$headers"
case $code in
  2??) ;;
  401|403) finish failed "the model endpoint rejected the API key (HTTP $code from $DRELLA_PREFLIGHT_URL)" ;;
  000) finish failed "the model endpoint is unreachable ($DRELLA_PREFLIGHT_URL)" ;;
  *) finish failed "the model endpoint answered HTTP $code ($DRELLA_PREFLIGHT_URL)" ;;
esac

# OpenCode's config, as rendered by Drella. The API key, if any, stays in the
# environment: the config refers to it as {env:DRELLA_LLM_KEY}.
# OpenCode would otherwise also load config and plugins from the repo (opencode.json,
# .opencode/), and project config wins: a repo could point the provider at its own URL
# and receive the key, or run a plugin. So project config is off for every opencode
# call below. That also stops OpenCode loading the repo's AGENTS.md / CLAUDE.md, so
# the standing instructions tell the agent to read them itself.
export OPENCODE_DISABLE_PROJECT_CONFIG=1
export OPENCODE_CONFIG="$WORK/opencode.json"
printf '%s\n' "$DRELLA_OPENCODE_CONFIG" >"$OPENCODE_CONFIG"
AGENT_MODEL=$(jq -er .model "$OPENCODE_CONFIG") \
  || finish failed "the job's OpenCode config names no model"

# -- 3. run the agent ----------------------------------------------------------

if [ -n "$REPO" ]; then
read -r -d '' STANDING <<INSTRUCTIONS
---
Standing instructions from Drella (always follow these):
- You are in a clone of https://github.com/$REPO. Its default branch is $DEFAULT_BRANCH.
- Do the work on a new branch named $BRANCH. Never commit to or push $DEFAULT_BRANCH.
- Commit your changes and push the branch to origin early and often.
- When the work is done, open a pull request against $DEFAULT_BRANCH with
  \`gh pr create\`, with a clear title and a description of what you changed.
- Before you start, read AGENTS.md, CLAUDE.md and CONTRIBUTING.md at the root of the
  repo, if they exist, and follow their conventions (they don't override these
  standing instructions).
- git and gh are already authenticated. Nobody can answer questions: decide for yourself.
INSTRUCTIONS
else
read -r -d '' STANDING <<INSTRUCTIONS
---
Standing instructions from Drella (always follow these):
- You are in an empty working directory. There is no repository for this job.
- Write your results as files in $OUT. Anything outside $OUT is thrown away.
- Nobody can answer questions: decide for yourself.
INSTRUCTIONS
fi

# The message starts with a fixed line, so a prompt beginning with "-" can't be
# read as an OpenCode option.
MESSAGE="Task from Drella:"$'\n'"$DRELLA_PROMPT"$'\n\n'"$STANDING"

# The soft limit: stop the agent AGENT_GRACE seconds before the hard limit.
budget=$((DEADLINE - AGENT_GRACE - $(date +%s)))
[ "$budget" -gt 60 ] || finish failed "no time left to run the agent (the deadline is too close)"

log "running opencode with $MODEL_LABEL (stops after ${budget}s)"
# Runs unattended in a throwaway pod, so it may use its tools without asking. It runs
# in the background so the TERM trap can fire while it works; the inner shell records
# the agent's pid and exit code.
phase=agent
agent_started=$(date +%s)
{
  timeout --signal=TERM --kill-after=30 "$budget" \
    opencode run --dangerously-skip-permissions --model "$AGENT_MODEL" "$MESSAGE" &
  echo $! >"$WORK/agent.pid"
  wait $!
  echo $? >"$WORK/agent.rc"
} 2>&1 | redact | tee "$OUT/transcript.txt" &
pipe_pid=$!
for _ in $(seq 100); do [ -s "$WORK/agent.pid" ] && break; sleep 0.1; done
agent_pid=$(cat "$WORK/agent.pid" 2>/dev/null)
# Told to stop before the pid was known.
[ -n "$stopped" ] && [ -n "$agent_pid" ] && kill -TERM "$agent_pid" 2>/dev/null
# `wait` returns early when the trap fires, so keep waiting until the agent is done.
while kill -0 "$pipe_pid" 2>/dev/null; do wait "$pipe_pid"; done
phase=collect
rc=$(cat "$WORK/agent.rc" 2>/dev/null)
[[ "$rc" =~ ^[0-9]+$ ]] || rc=1  # no exit code recorded: treat as a failure
elapsed=$(($(date +%s) - agent_started))
log "opencode exited with $rc after ${elapsed}s"

# Why the job has failed, if it already has. Reported straight away, so the status
# doesn't depend on step 4; the final report adds the PR, if there is one.
failure() {
  if [ -n "$stopped" ]; then
    echo "the job was stopped (pod deleted, evicted or drained)"
  elif [ "$rc" -ne 0 ] && [ "$elapsed" -ge "$budget" ]; then
    # Stopped by the timer (124, or 137 if it had to be killed).
    echo "the agent ran out of time (stopped after ${budget}s)"
  elif [ "$rc" -eq 137 ]; then
    echo "the agent was killed (exit 137, possibly out of memory)"
  elif [ "$rc" -ne 0 ]; then
    echo "opencode exited with $rc"
  fi
}
reason=$(failure)
[ -n "$reason" ] && report failed "$reason"

# -- 4. collect outputs --------------------------------------------------------

# Each step is bounded, so a hung tool can't use up the time left for reporting.
session=$(within 20 opencode session list -n 1 --format json 2>/dev/null | jq -r '.[0].id // empty')
[ -n "$session" ] && within 20 opencode export "$session" 2>/dev/null | redact >"$OUT/session.json"

pr="" diff_note="" pr_lookup_failed=""
if [ -n "$REPO" ]; then
  # Everything that changed since the clone, committed or not.
  within 30 git add -A -N
  if ! within 30 git diff --binary "$BASE" >"$OUT/diff.patch"; then
    diff_note="; diff.patch is incomplete (git diff failed or timed out)"
  fi

  branch=$(git branch --show-current)
  pr_lookup_failed=""
  for b in "$BRANCH" "$branch"; do
    [ -n "$b" ] && [ "$b" != "$DEFAULT_BRANCH" ] || continue
    # Only a PR opened by this job counts, not an older one on a reused branch.
    if ! pr=$(within 20 gh pr list --repo "$REPO" --head "$b" --state all --json url,createdAt \
      --jq "[.[] | select(.createdAt >= \"$STARTED\")][0].url // empty" 2>/dev/null); then
      pr="" pr_lookup_failed=1
    fi
    [ -n "$pr" ] && break
  done
  [ -n "$pr" ] && echo "$pr" >"$OUT/pr-url.txt"
fi

# -- 5. report -----------------------------------------------------------------

# Told to stop during step 4 counts too: the job didn't get to finish normally.
reason=$(failure)
if [ -n "$reason" ]; then
  finish failed "$reason${pr:+; PR: $pr}$diff_note"
elif [ -z "$REPO" ]; then
  # The agent's results are files in /out; the transcript and session are ours.
  # Counts exactly what upload_outputs uploads (is_output).
  results=0
  for f in "$OUT"/*; do
    is_output "$f" || continue
    case ${f##*/} in transcript.txt|session.json) ;; *) results=$((results + 1)) ;; esac
  done
  if [ "$results" -gt 0 ]; then
    finish succeeded "done"
  else
    finish failed "the agent wrote no outputs to $OUT"
  fi
elif [ -z "$pr" ] && [ -n "$pr_lookup_failed" ]; then
  finish failed "couldn't check for a pull request (gh pr list failed or timed out)$diff_note"
elif [ -z "$pr" ]; then
  finish failed "the agent didn't open a pull request$diff_note"
else
  finish succeeded "$pr$diff_note"
fi
