#!/usr/bin/env bash
# Drella job wrapper [21]. Runs inside the job pod:
#   1. with a repo (DRELLA_REPO): clones it with the GitHub credential (/creds/github).
#      Without one: starts in an empty working directory;
#   2. sets up the agent Drella chose for the job's model (DRELLA_AGENT): OpenCode,
#      after checking the model endpoint and writing OpenCode's config, both rendered
#      by Drella (DRELLA_PREFLIGHT_*, DRELLA_OPENCODE_CONFIG; docs/v0.2.md); or Claude
#      Code with the model's OAuth token (DRELLA_AGENT_MODEL; docs/v0.3.md);
#   3. runs the agent with the prompt and standing instructions: with a repo, work on
#      a branch, push it and open a PR with gh; without one, or with a GitHub token
#      that doesn't open PRs (DRELLA_REPO_REPORT), write results to /out. A read-only
#      token (DRELLA_REPO_READ_ONLY) can't write to GitHub at all; a report job's token
#      can (superstar, issue #73), and it acts on GitHub with gh during the run;
#   4. collects /out (transcript, plus diff and PR URL for a repo job);
#   5. reports the final status with the job-scoped token, then uploads /out to the
#      Drella API. A repo job succeeds only if a PR exists; a job without a repo, or
#      a report job, succeeds if the agent exits cleanly and wrote at least one
#      output.
#
# Time limits (docs/v0.md): the agent runs under a timer that stops it
# DRELLA_AGENT_GRACE seconds before DRELLA_DEADLINE (the Job's hard limit). If the pod
# is told to stop (TERM), the agent is stopped too. Either way, everything after the
# agent shares whatever time is left: until the deadline, or until the pod's grace
# period (DRELLA_TERM_GRACE) ends. If the job has already failed when the agent ends
# (stopped, out of time, killed), that status is reported straight away, before
# step 4. DRELLA_DRAIN_GRACE (default 10) is how long the agent's output gets to drain
# once it has exited (never into the last RESERVE seconds); then whatever the agent
# left running in its process group is stopped. Step 4 stops RESERVE seconds early, leaving the final status that long to
# reach the Drella API (less if the provisional report used it up).
set -uo pipefail

: "${DRELLA_API_URL:?}" "${DRELLA_JOB_ID:?}" "${DRELLA_JOB_TOKEN:?}" "${DRELLA_PROMPT:?}"
AGENT=${DRELLA_AGENT:-opencode}
# A mismatch between Drella and this image (an unknown agent, or its settings
# missing) is reported as the job's failure once the API helpers exist, below.
setup_error=""
case $AGENT in
  opencode)
    [ -n "${DRELLA_OPENCODE_CONFIG:-}" ] && [ -n "${DRELLA_PREFLIGHT_URL:-}" ] \
      || setup_error="this job image is missing OpenCode's settings (DRELLA_OPENCODE_CONFIG, DRELLA_PREFLIGHT_URL); is the image the same version as Drella?" ;;
  claude-code)
    [ -n "${DRELLA_AGENT_MODEL:-}" ] \
      || setup_error="this job image is missing Claude Code's model (DRELLA_AGENT_MODEL); is the image the same version as Drella?" ;;
  *) setup_error="this job image doesn't know the agent '${AGENT:0:40}'; is the image the same version as Drella?" ;;
esac
MODEL_LABEL=${DRELLA_MODEL_LABEL:-${DRELLA_PREFLIGHT_URL:-$AGENT}}
OUT=${DRELLA_OUT:-/out}
WORK=${DRELLA_WORK:-/work}
CREDS=${DRELLA_CREDS:-/creds}
REPO=${DRELLA_REPO:-}
# An existing PR to push fixes to (docs/v0.3.md), instead of opening a new one.
FIX_PR=${DRELLA_PR:-}
# The GitHub token can't write at all (a read-only profile).
READ_ONLY=""
[ -n "$REPO" ] && [ "${DRELLA_REPO_READ_ONLY:-}" = 1 ] && READ_ONLY=1
# The job's outcome is its results in /out, not a PR: a read-only token, or a token that
# doesn't open PRs (superstar).
REPORT=""
[ -n "$REPO" ] && { [ -n "$READ_ONLY" ] || [ "${DRELLA_REPO_REPORT:-}" = 1 ]; } && REPORT=1
BRANCH="drella/${DRELLA_JOB_ID:0:8}"
STARTED=$(date -u +%Y-%m-%dT%H:%M:%SZ)
NOW=$(date +%s)
DEADLINE=${DRELLA_DEADLINE:-$((NOW + 3600))}
AGENT_GRACE=${DRELLA_AGENT_GRACE:-300}
TERM_GRACE=${DRELLA_TERM_GRACE:-120}
MARGIN=10   # stop this long before being killed
RESERVE=30  # step 4 leaves this long for the final status report

# Everything has to be done by FINISH_BY: the hard deadline, or the end of the grace
# period once the pod has been told to stop.
FINISH_BY=$((DEADLINE - MARGIN))
left() { echo $((FINISH_BY - $(date +%s))); }
# within MAX CMD...: run a step-4 command for at most MAX seconds, and never into the
# time reserved for the final status report.
within() {
  local t
  t=$(($(left) - RESERVE))
  [ "$t" -gt "$1" ] && t=$1
  [ "$t" -ge 1 ] || return 124
  shift
  timeout --kill-after=2 "$t" "$@"
}

log() { echo "[drella] $*"; }

# Calls to the Drella API. Drella may be restarting (e.g. an upgrade), so retry,
# including refused connections, for as long as there's time left. The calls are
# idempotent.
api() {
  local t
  t=$(left)
  [ "$t" -ge 5 ] || { log "no time left to call the Drella API"; return 1; }
  timeout "$t" curl -fsS --retry 1000 --retry-delay 5 --retry-max-time "$t" \
    --retry-connrefused -m 120 -H "Authorization: Bearer $DRELLA_JOB_TOKEN" "$@"
}

# Replace the job's secrets (the model's API key, the GitHub token, the job token, and an
# operator job's API token and builder token) with [redacted] in a stream, line by line. The agent can read
# them all from its environment; this keeps them out of the transcript, the session
# record and the archived log if it prints them. Best effort: a secret split across
# lines, or encoded, gets through, and so does anything the agent writes to other files in /out, sends to the Drella API
# with the job token, or writes straight to the pod's log (docs/v0.2.md#security).
# Values come from ENVIRON and are matched as fixed strings, so any character is safe.
# A single huge line full of secrets is slow to filter (each match copies the rest of
# the line); only an agent printing them on purpose produces that.
redact() {
  awk 'BEGIN {
      n = 0
      if (length(ENVIRON["DRELLA_LLM_KEY"]) >= 8) k[++n] = ENVIRON["DRELLA_LLM_KEY"]
      if (length(ENVIRON["GH_TOKEN"]) >= 8) k[++n] = ENVIRON["GH_TOKEN"]
      if (length(ENVIRON["DRELLA_JOB_TOKEN"]) >= 8) k[++n] = ENVIRON["DRELLA_JOB_TOKEN"]
      if (length(ENVIRON["DRELLA_API_TOKEN"]) >= 8) k[++n] = ENVIRON["DRELLA_API_TOKEN"]
      if (length(ENVIRON["DRELLA_BUILDER_TOKEN"]) >= 8) k[++n] = ENVIRON["DRELLA_BUILDER_TOKEN"]
    }
    {
      line = $0
      for (i = 1; i <= n; i++) {
        out = ""
        while ((p = index(line, k[i])) > 0) {
          out = out substr(line, 1, p - 1) "[redacted]"
          line = substr(line, p + length(k[i]))
        }
        line = out line
      }
      print line
      fflush()
    }'
}

# An output is a regular file (not a symlink) at the top level of /out whose name
# Drella accepts (letters, digits, ".", "_", "-"; not starting with "."). Nothing else
# is uploaded.
is_output() {
  [ -f "$1" ] && [ ! -L "$1" ] && [[ ${1##*/} =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]]
}

upload_outputs() {
  local f
  # Most useful first, in case time runs out.
  for f in "$OUT/pr-url.txt" "$OUT/diff.patch" "$OUT/transcript.txt" "$OUT"/*; do
    is_output "$f" || continue
    case " $uploaded " in *" $f "*) continue ;; esac
    uploaded="$uploaded $f"
    log "uploading $(basename "$f")"
    api -T "$f" "$DRELLA_API_URL/jobs/$DRELLA_JOB_ID/outputs/$(basename "$f")" \
      || log "upload of $(basename "$f") failed"
  done
}

# report STATUS MESSAGE: tell Drella the job's status. Drella keeps the latest report
# while the job runs, so a provisional status can be replaced by a final one.
report() {
  log "$1: $2"
  local body
  body=$(jq -n --arg s "$1" --arg m "$2" --argjson u "${USAGE:-null}" \
    '{status: $s, message: $m} + (if $u then {usage: $u} else {} end)')
  api -X POST -H 'Content-Type: application/json' -d "$body" \
    "$DRELLA_API_URL/jobs/$DRELLA_JOB_ID/status" && return
  if [ -n "${USAGE:-}" ]; then
    # Usage is a bonus; if the report with it failed, the status mustn't be lost.
    log "reporting status with usage failed; retrying without it"
    api -X POST -H 'Content-Type: application/json' \
      -d "$(jq -n --arg s "$1" --arg m "$2" '{status: $s, message: $m}')" \
      "$DRELLA_API_URL/jobs/$DRELLA_JOB_ID/status" && return
  fi
  log "reporting status failed"
}

# finish STATUS MESSAGE: report, upload outputs, exit. The status goes first: it
# matters most, and Drella accepts outputs until the pod has exited.
uploaded=""
finish() {
  phase=finishing
  report "$1" "$2"
  upload_outputs
  [ "$1" = succeeded ]
  exit
}

# Where the wrapper is: setup (steps 1-2), agent (3), collect (4), finishing (5).
phase=setup agent_pid="" stopped=""
# Told to stop (pod deleted, evicted, node drained). The pod is killed when its grace
# period ends, so everything left has to fit in it.
on_term() {
  [ -n "$stopped" ] && return
  stopped=1
  local by=$(($(date +%s) + TERM_GRACE - MARGIN))
  [ "$by" -lt "$FINISH_BY" ] && FINISH_BY=$by
  log "told to stop during $phase; finishing within $(left)s"
  case $phase in
    setup) finish failed "the job was stopped before the agent started" ;;
    # Stop the agent. If its pid isn't known yet, that happens as soon as it is.
    agent) [ -n "$agent_pid" ] && kill -TERM "$agent_pid" 2>/dev/null ;;
    # collect, finishing: carry on within the shorter time; the result says "stopped".
  esac
}
trap on_term TERM INT
[ -z "$setup_error" ] || finish failed "$setup_error"

# -- 1. workspace -------------------------------------------------------------

export GH_PROMPT_DISABLED=1 GIT_TERMINAL_PROMPT=0
if [ -s "$CREDS/github" ]; then
  export GH_TOKEN
  GH_TOKEN=$(<"$CREDS/github")
  # git authenticates with the same token, for the clone and the agent's pushes, and
  # only to https://github.com: never to another host (a submodule, a git dependency)
  # or over plain http.
  git config --global credential.https://github.com.helper \
    '!f() { echo username=x-access-token; echo "password=$GH_TOKEN"; }; f'
  if user=$(gh api user --jq '"\(.login) \(.id)"' 2>/dev/null); then
    read -r login id <<<"$user"
    git config --global user.name "$login"
    git config --global user.email "$id+$login@users.noreply.github.com"
  fi
fi
git config --global user.name >/dev/null || git config --global user.name "Drella agent"
git config --global user.email >/dev/null || git config --global user.email "drella@users.noreply.github.com"

# Fix-PR job: check the PR is one the job may push to, check its branch out and bring it
# up to date with the default branch. Sets PR_BRANCH and PR_HEAD (the branch's remote
# head before the agent runs) and CONFLICT_NOTE (for the agent, if main can't be
# brought in).
PR_BRANCH="" PR_HEAD="" CONFLICT_NOTE=""
prepare_fix_pr() {
  [[ $FIX_PR =~ ^[1-9][0-9]{0,9}$ ]] || finish failed "DRELLA_PR isn't a PR number"
  local info state cross
  info=$(timeout 60 gh pr view "$FIX_PR" --json state,headRefName,headRepositoryOwner,isCrossRepository 2>&1) \
    || finish failed "couldn't look up PR #$FIX_PR in $REPO"
  state=$(jq -r .state <<<"$info") cross=$(jq -r .isCrossRepository <<<"$info")
  PR_BRANCH=$(jq -r .headRefName <<<"$info")
  [ "$state" = OPEN ] || finish failed "PR #$FIX_PR isn't open (it is ${state:-unknown})"
  [ "$cross" = false ] || finish failed "PR #$FIX_PR comes from a fork (cross-repository); Drella only pushes to branches in $REPO"
  if [ -z "$PR_BRANCH" ] || [ "$PR_BRANCH" = "$DEFAULT_BRANCH" ] || [ "$PR_BRANCH" = main ]; then
    finish failed "PR #$FIX_PR's branch is the default branch; Drella won't push to it"
  fi
  case $PR_BRANCH in
    drella/*) ;;
    *) finish failed "PR #$FIX_PR's branch '${PR_BRANCH:0:80}' isn't under drella/; Drella only pushes to its own branches" ;;
  esac
  git fetch origin "+refs/heads/$PR_BRANCH:refs/remotes/origin/$PR_BRANCH" \
    || finish failed "couldn't fetch branch $PR_BRANCH of PR #$FIX_PR"
  git checkout -B "$PR_BRANCH" "origin/$PR_BRANCH" || finish failed "couldn't check out $PR_BRANCH"
  # What the agent starts from; the diff is against it. Taken before main is brought in.
  PR_HEAD=$(git rev-parse "origin/$PR_BRANCH")
  git fetch origin "$DEFAULT_BRANCH" >/dev/null 2>&1
  if git rebase "origin/$DEFAULT_BRANCH" >/dev/null 2>&1; then
    log "rebased $PR_BRANCH onto origin/$DEFAULT_BRANCH"
  else
    git rebase --abort >/dev/null 2>&1
    if git merge --no-edit "origin/$DEFAULT_BRANCH" >/dev/null 2>&1; then
      log "rebase conflicted; merged origin/$DEFAULT_BRANCH into $PR_BRANCH instead"
    else
      git merge --abort >/dev/null 2>&1
      log "$PR_BRANCH conflicts with origin/$DEFAULT_BRANCH"
      CONFLICT_NOTE="- $PR_BRANCH conflicts with origin/$DEFAULT_BRANCH: neither a rebase nor a merge worked, so the branch is as it was. Resolve the conflicts first (git rebase origin/$DEFAULT_BRANCH, or git merge origin/$DEFAULT_BRANCH), then make your change."
    fi
  fi
  # The diff shows what the agent changed, not what the rebase or merge brought in.
  BASE=$(git rev-parse HEAD)
}

if [ -n "$REPO" ]; then
  [ -s "$CREDS/github" ] || finish failed "a job with a repo needs a github credential"
  log "cloning $REPO"
  git clone "https://github.com/$REPO.git" "$WORK/repo" || finish failed "clone failed"
  cd "$WORK/repo" || finish failed "no checkout"
  BASE=$(git rev-parse HEAD)
  DEFAULT_BRANCH=$(git branch --show-current)
  [ -z "$FIX_PR" ] || [ -n "$REPORT" ] || prepare_fix_pr
else
  mkdir -p "$WORK/space" && cd "$WORK/space" || finish failed "no working directory"
fi

# -- 2. configure the agent ----------------------------------------------------

setup_opencode() {
# OpenCode retries an unreachable endpoint until the job times out, so check first.
# Drella's adapter for the model says what to call and with which headers; header
# values refer to the API key as {key}. The headers go through a private file, so the
# key isn't on curl's command line.
headers="$WORK/preflight-headers"
(umask 077; : >"$headers")
while IFS= read -r h; do
  # The replacement is quoted, so "&" in a key isn't expanded (bash 5.2 patsub).
  [ -n "$h" ] && printf '%s\n' "${h//'{key}'/"${DRELLA_LLM_KEY:-}"}" >>"$headers"
done <<<"${DRELLA_PREFLIGHT_HEADERS:-}"
# -g: the URL is used as is ("[" and "]" are never ranges).
code=$(curl -gsS -m 20 -o /dev/null -w '%{http_code}' -H @"$headers" "$DRELLA_PREFLIGHT_URL")
rm -f "$headers"
case $code in
  2??) ;;
  401|403) finish failed "the model endpoint rejected the API key (HTTP $code from $DRELLA_PREFLIGHT_URL)" ;;
  000) finish failed "the model endpoint is unreachable ($DRELLA_PREFLIGHT_URL)" ;;
  *) finish failed "the model endpoint answered HTTP $code ($DRELLA_PREFLIGHT_URL)" ;;
esac

# OpenCode's config, as rendered by Drella. The API key, if any, stays in the
# environment: the config refers to it as {env:DRELLA_LLM_KEY}.
# OpenCode would otherwise also load config and plugins from the repo (opencode.json,
# .opencode/), and project config wins: a repo could point the provider at its own URL
# and receive the key, or run a plugin. So project config is off for every opencode
# call below. That also stops OpenCode loading the repo's AGENTS.md / CLAUDE.md, so
# the standing instructions tell the agent to read them itself.
export OPENCODE_DISABLE_PROJECT_CONFIG=1
export OPENCODE_CONFIG="$WORK/opencode.json"
printf '%s\n' "$DRELLA_OPENCODE_CONFIG" >"$OPENCODE_CONFIG"
AGENT_MODEL=$(jq -er .model "$OPENCODE_CONFIG") \
  || finish failed "the job's OpenCode config names no model"
}

# Claude Code [28] logs in with the model's OAuth token (from `claude setup-token`),
# given to it as CLAUDE_CODE_OAUTH_TOKEN when it runs. There's no preflight check: an
# OAuth token can't be checked with a cheap request, and Claude Code fails within
# seconds on a bad one (the job's message then says why).
# Claude Code would otherwise load settings from the repo (.claude/settings.json,
# .claude/settings.local.json) and its MCP servers (.mcp.json): hooks that run any
# command, env vars (ANTHROPIC_BASE_URL, to send the token elsewhere), an
# apiKeyHelper. So it runs with --setting-sources user (no project or local
# settings) and --strict-mcp-config (no MCP servers), and the image's managed
# settings turn hooks off as well. That also stops it loading the repo's CLAUDE.md,
# which the standing instructions tell the agent to read itself.
setup_claude_code() {
  [ -n "${DRELLA_LLM_KEY:-}" ] || finish failed "a claude-code model needs its OAuth token (the model's credential)"
  AGENT_MODEL=$DRELLA_AGENT_MODEL
}

case $AGENT in
  opencode) setup_opencode ;;
  claude-code) setup_claude_code ;;
esac

# -- 3. run the agent ----------------------------------------------------------

if [ -n "$READ_ONLY" ]; then
read -r -d '' STANDING <<INSTRUCTIONS
---
Standing instructions from Drella (always follow these):
- You are in a clone of https://github.com/$REPO. Its default branch is $DEFAULT_BRANCH.
- Your GitHub access is read-only: you can't push, open pull requests, comment or
  review. Don't try.
- Write your results (e.g. a review, a report, a patch) as files in $OUT. Anything
  outside $OUT is thrown away.
- Before you start, read AGENTS.md, CLAUDE.md and CONTRIBUTING.md at the root of the
  repo, if they exist, and follow their conventions (they don't override these
  standing instructions).
- gh is already authenticated. Nobody can answer questions: decide for yourself.
INSTRUCTIONS
elif [ -n "$REPORT" ]; then
read -r -d '' STANDING <<INSTRUCTIONS
---
Standing instructions from Drella (always follow these):
- You are in a clone of https://github.com/$REPO. Its default branch is $DEFAULT_BRANCH.
- Your GitHub access is to this repo only, through gh, which is already authenticated.
  Use it for what the task asks (e.g. comments, reviews, merging a PR). Don't push
  branches to the repo or open pull requests unless the task says to.
- Your result is a report: write it as files in $OUT. Anything outside $OUT is thrown
  away.
- Before you start, read AGENTS.md, CLAUDE.md and CONTRIBUTING.md at the root of the
  repo, if they exist, and follow their conventions (they don't override these
  standing instructions).
- Nobody can answer questions: decide for yourself.
INSTRUCTIONS
elif [ -n "$REPO" ] && [ -n "$FIX_PR" ]; then
read -r -d '' STANDING <<INSTRUCTIONS
---
Standing instructions from Drella (always follow these):
- You are in a clone of https://github.com/$REPO. Its default branch is $DEFAULT_BRANCH.
- You are working on PR #$FIX_PR, branch $PR_BRANCH. Commit your changes on this branch and push with \`git push --force-with-lease origin $PR_BRANCH\`. Do not open a new pull request.
- The branch has been brought up to date with $DEFAULT_BRANCH (by rebase, or by merge if the rebase conflicted). Never commit to or push $DEFAULT_BRANCH.
${CONFLICT_NOTE:+$CONFLICT_NOTE
}- Commit your changes and push the branch to origin early and often.
- Before you start, read AGENTS.md, CLAUDE.md and CONTRIBUTING.md at the root of the
  repo, if they exist, and follow their conventions (they don't override these
  standing instructions).
- git and gh are already authenticated. Nobody can answer questions: decide for yourself.
INSTRUCTIONS
elif [ -n "$REPO" ]; then
read -r -d '' STANDING <<INSTRUCTIONS
---
Standing instructions from Drella (always follow these):
- You are in a clone of https://github.com/$REPO. Its default branch is $DEFAULT_BRANCH.
- Do the work on a new branch named $BRANCH. Never commit to or push $DEFAULT_BRANCH.
- Commit your changes and push the branch to origin early and often.
- When the work is done, open a pull request against $DEFAULT_BRANCH with
  \`gh pr create\`, with a clear title and a description of what you changed.
- Before you start, read AGENTS.md, CLAUDE.md and CONTRIBUTING.md at the root of the
  repo, if they exist, and follow their conventions (they don't override these
  standing instructions).
- git and gh are already authenticated. Nobody can answer questions: decide for yourself.
INSTRUCTIONS
else
read -r -d '' STANDING <<INSTRUCTIONS
---
Standing instructions from Drella (always follow these):
- You are in an empty working directory. There is no repository for this job.
- Write your results as files in $OUT. Anything outside $OUT is thrown away.
- Nobody can answer questions: decide for yourself.
INSTRUCTIONS
fi

# An operator token's job (issue #74) can queue and read its caller's jobs with its own
# job-scoped API token.
if [ -n "${DRELLA_API_TOKEN:-}" ]; then
  STANDING+=$'\n'"- You can create and read Drella jobs as the caller who queued you, with the Drella API at \$DRELLA_API_URL and \$DRELLA_API_TOKEN as a bearer token: POST /jobs, GET /jobs, GET /jobs/{id}, GET /jobs/{id}/logs, GET /jobs/{id}/outputs/{name} and GET /models (to choose a model). A job you queue with it gets a read-only GitHub token by default. You may pass \"profile\": \"builder\" in the POST /jobs body (needed for a job that opens a PR or has \"pr\") if your caller's own GitHub profile allows it; never \"superstar\". If your caller has a stored github credential, you can only queue jobs without a \"repo\", and a \"profile\" other than your caller's own is refused. The token works only until this job ends, and only for a limited number of new jobs. Never print it."
fi
if [ -n "${DRELLA_BUILDER_TOKEN:-}" ]; then
  STANDING+=$'\n'"- \$DRELLA_BUILDER_TOKEN is a separate Drella token for queueing build and fix jobs as an ordinary caller (POST /jobs with it as the bearer token, then read those jobs with it). Never print it."
fi

# The message starts with a fixed line, so a prompt beginning with "-" can't be
# read as an option.
MESSAGE="Task from Drella:"$'\n'"$DRELLA_PROMPT"$'\n\n'"$STANDING"

# The soft limit: stop the agent AGENT_GRACE seconds before the hard limit.
budget=$((DEADLINE - AGENT_GRACE - $(date +%s)))
[ "$budget" -gt 60 ] || finish failed "no time left to run the agent (the deadline is too close)"

# Runs unattended in a throwaway pod, so the agent may use its tools without asking.
case $AGENT in
  opencode)
    agent_cmd=(opencode run --dangerously-skip-permissions --model "$AGENT_MODEL" "$MESSAGE") ;;
  claude-code)
    agent_cmd=(claude -p --model="$AGENT_MODEL" --output-format stream-json --verbose
      --dangerously-skip-permissions --setting-sources user --strict-mcp-config "$MESSAGE") ;;
esac

# The transcript: OpenCode's output as it is; Claude Code's stream of JSON events
# (kept whole as session.jsonl) turned into readable lines. Lines that aren't JSON
# pass through.
render() {
  if [ "$AGENT" != claude-code ]; then cat; return; fi
  jq -Rr --unbuffered '. as $line | try (fromjson |
    if .type == "system" and .subtype == "init" then
      "[claude] session \(.session_id), model \(.model)"
    elif .type == "assistant" then
      (.message.content[]? |
        if .type == "text" then .text
        elif .type == "tool_use" then "-> \(.name) \(.input | tostring | .[0:300])"
        else empty end)
    elif .type == "user" then
      (.message.content[]? | select(.type == "tool_result") |
        "<- " + ((.content | if type == "string" then . else (map(.text? // "") | join(" ")) end) | .[0:300]))
    elif .type == "result" then
      "[claude] \(if .is_error then "error" else .subtype end): \(.num_turns // "?") turns, \(((.duration_ms // 0) / 1000) | floor)s"
        + (if .is_error then ": \(.result // "error")" else "" end)
    else empty end) catch $line'
}

log "running $AGENT with $MODEL_LABEL (stops after ${budget}s)"
# The agent runs in the background so the TERM trap can fire while it works. It is the
# wrapper's own child: its pid is $! and its exit code comes from `wait`, never from a
# file (the agent could write one). Its output reaches the transcript pipeline through
# a FIFO, opened by both ends before the agent starts.
# -- agent: start (tests/test_wrapper.py runs everything from here to "agent: end")
phase=agent
agent_started=$(date +%s)
fifo="$WORK/agent.fifo"
rm -f "$fifo"
mkfifo -m 600 "$fifo" || finish failed "couldn't create the pipe for the agent's output"
redact <"$fifo" | tee "$WORK/agent.out" | render | tee -a "$OUT/transcript.txt" &
pipe_pid=$!
(
  # Claude Code's token, for the agent only: set in this subshell, so it's never on a
  # command line.
  [ "$AGENT" = claude-code ] && export CLAUDE_CODE_OAUTH_TOKEN=$DRELLA_LLM_KEY
  # setsid: the agent and everything it starts get their own session and process
  # group (its id is the agent's pid), so that leftovers can be stopped without
  # touching the wrapper.
  exec setsid timeout --signal=TERM --kill-after=30 "$budget" "${agent_cmd[@]}"
) >"$fifo" 2>&1 &
agent_pid=$!
# Told to stop just before the pid was known.
[ -n "$stopped" ] && kill -TERM "$agent_pid" 2>/dev/null
# wait_for_agent: wait for the agent itself, not for the pipeline: a process the agent
# left running (a dev server) can hold the pipe open for ever. Once the agent has
# exited, the pipeline gets DRAIN_GRACE seconds to drain; then the agent's process
# group is always killed (a leftover may not hold the pipe: `npm run dev > dev.log &`),
# and if the pipeline still doesn't end, the pipeline itself. Never the wrapper.
# Polls rather than `wait`s, which returns early when the trap fires. Sets agent_ended
# (when the agent stopped) and stopped_at_deadline (the wrapper had to kill it).
DRAIN_GRACE=${DRELLA_DRAIN_GRACE:-10}
[[ $DRAIN_GRACE =~ ^[0-9]+$ ]] || DRAIN_GRACE=10
pipeline_running() { kill -0 "$pipe_pid" 2>/dev/null; }
agent_running() { kill -0 "$agent_pid" 2>/dev/null; }
# A process group the wrapper may kill: never 0 (its own), 1 or -1 (everything).
agent_group_ok() { [[ $agent_pid =~ ^[0-9]+$ ]] && [ "$agent_pid" -ge 2 ]; }
agent_ended="" stopped_at_deadline=""
wait_for_agent() {
  local i p leftovers="" escaped=""
  # The agent is bounded by its own timer; FINISH_BY bounds the rest, and the last
  # RESERVE seconds belong to the final report.
  while agent_running && [ "$(left)" -gt "$RESERVE" ]; do sleep 0.2; done
  if agent_running; then
    # Out of time with the agent still going: no drain, stop it at once.
    stopped_at_deadline=1
  else
    agent_ended=$(date +%s)
    for ((i = 0; i < DRAIN_GRACE * 5 && $(left) > RESERVE; i++)); do pipeline_running || break; sleep 0.2; done
  fi
  if agent_group_ok; then
    kill -0 -- "-$agent_pid" 2>/dev/null && leftovers=1
    kill -KILL -- "-$agent_pid" 2>/dev/null
  fi
  [ -n "$agent_ended" ] || agent_ended=$(date +%s)
  for ((i = 0; i < 10; i++)); do pipeline_running || break; sleep 0.2; done
  if pipeline_running; then
    # Something outside the agent's group (setsid, a daemon) holds the pipe. The
    # pipeline's own processes are the wrapper's only children.
    escaped=1
    for p in /proc/[0-9]*; do
      p=${p#/proc/}
      [ "$(awk '/^PPid:/ {print $2}' "/proc/$p/status" 2>/dev/null)" = "$$" ] && kill -KILL "$p" 2>/dev/null
    done
    for ((i = 0; i < 10; i++)); do pipeline_running || break; sleep 0.2; done
  fi
  if [ -n "$stopped_at_deadline" ]; then
    log "the agent was still running at the deadline; stopped it" | tee -a "$OUT/transcript.txt"
  elif [ -n "$leftovers" ]; then
    log "the agent left processes running; stopped the agent's leftover processes" | tee -a "$OUT/transcript.txt"
  fi
  [ -n "$escaped" ] && log "stopped what it could; processes that left the agent's process group may still be running" | tee -a "$OUT/transcript.txt"
  return 0
}
wait_for_agent
phase=collect
# The agent has ended (or was killed above), so this doesn't block.
wait "$agent_pid" 2>/dev/null
rc=$?
rm -f "$fifo"
# The agent's run time, without the drain: a late error isn't a timeout.
elapsed=$((agent_ended - agent_started))
log "$AGENT exited with $rc after ${elapsed}s"
# -- agent: end

# The agent's raw output, as recorded. The agent runs as the same user and could swap
# $WORK/agent.out for a symlink (e.g. to /creds/github) or a FIFO, so it's read only if
# it's a regular file, never through a symlink (dd's nofollow), for a bounded time, and
# redacted again on the way out.
agent_out() {
  local f="$WORK/agent.out"
  [ -f "$f" ] && [ ! -L "$f" ] || return 0
  timeout --kill-after=2 20 dd if="$f" iflag=nofollow status=none 2>/dev/null | redact
}

# Why the job has failed, if it already has. Reported straight away, so the status
# doesn't depend on step 4; the final report adds the PR, if there is one.
failure() {
  if [ -n "$stopped" ]; then
    echo "the job was stopped (pod deleted, evicted or drained)"
  elif [ -n "$stopped_at_deadline" ]; then
    # The wrapper killed it (exit 137), not its timer or the kernel.
    echo "the agent was still running at the deadline and was stopped"
  elif [ "$rc" -ne 0 ] && [ "$elapsed" -ge "$budget" ]; then
    # Stopped by the timer (124, or 137 if it had to be killed).
    echo "the agent ran out of time (stopped after ${budget}s)"
  elif [ "$rc" -eq 137 ]; then
    echo "the agent was killed (exit 137, possibly out of memory)"
  elif [ "$rc" -ne 0 ]; then
    # Claude Code's own reason, if it gave one (already redacted).
    local why=""
    [ "$AGENT" = claude-code ] && why=$(agent_out | jq -Rr 'try (fromjson | select(.type == "result" and .is_error) | .result // empty) catch empty' 2>/dev/null | tail -n 1 | cut -c1-200)
    echo "$AGENT exited with $rc${why:+: $why}"
  fi
}
reason=$(failure)
[ -n "$reason" ] && report failed "$reason"

# -- 4. collect outputs --------------------------------------------------------

# Each step is bounded, so a hung tool can't use up the time left for reporting.
if [ "$AGENT" = claude-code ]; then
  # Claude Code's stream of events is its session record: redacted as it's recorded,
  # and again as it's copied (see agent_out).
  agent_out >"$OUT/session.jsonl"
  [ -s "$OUT/session.jsonl" ] || rm -f "$OUT/session.jsonl"
else
  session=$(within 20 opencode session list -n 1 --format json 2>/dev/null | jq -r '.[0].id // empty')
  if [ -n "$session" ]; then
    raw=$(mktemp) || { log "mktemp failed, skipping session export"; }
    if [ -n "$raw" ]; then
      within 20 opencode export "$session" 2>/dev/null >"$raw"
      redact <"$raw" >"$OUT/session.json"
      rm -f "$raw"
      [ -s "$OUT/session.json" ] || rm -f "$OUT/session.json"
      if [ -f "$OUT/session.json" ] && ! jq -e . "$OUT/session.json" >/dev/null 2>&1; then
        log "session.json is not valid JSON ($(wc -c <"$OUT/session.json") bytes)"
      fi
    fi
  fi
fi

pr="" diff_note="" pr_lookup_failed=""
if [ -n "$REPO" ]; then
  # Everything that changed since the clone, committed or not.
  within 30 git add -A -N
  if ! within 30 git diff --binary "$BASE" >"$OUT/diff.patch"; then
    diff_note="; diff.patch is incomplete (git diff failed or timed out)"
  fi
fi

if [ -n "$FIX_PR" ] && [ -n "$REPO" ] && [ -z "$REPORT" ]; then
  # A fix-PR job succeeds if the PR's branch moved on the remote.
  if remote_head=$(within 30 git ls-remote origin "refs/heads/$PR_BRANCH" 2>/dev/null); then
    remote_head=${remote_head%%[[:space:]]*}
    if [ -n "$remote_head" ] && [ "$remote_head" != "$PR_HEAD" ]; then
      pr=$(within 20 gh pr view "$FIX_PR" --json url --jq .url 2>/dev/null) || pr=""
      [ -n "$pr" ] || pr="https://github.com/$REPO/pull/$FIX_PR"
      echo "$pr" >"$OUT/pr-url.txt"
    fi
  else
    pr_lookup_failed=1
  fi
elif [ -n "$REPO" ] && [ -z "$REPORT" ]; then
  branch=$(git branch --show-current)
  pr_lookup_failed=""
  for b in "$BRANCH" "$branch"; do
    [ -n "$b" ] && [ "$b" != "$DEFAULT_BRANCH" ] || continue
    # Only a PR opened by this job counts, not an older one on a reused branch.
    if ! pr=$(within 20 gh pr list --repo "$REPO" --head "$b" --state all --json url,createdAt \
      --jq "[.[] | select(.createdAt >= \"$STARTED\")][0].url // empty" 2>/dev/null); then
      pr="" pr_lookup_failed=1
    fi
    [ -n "$pr" ] && break
  done
  [ -n "$pr" ] && echo "$pr" >"$OUT/pr-url.txt"
fi

# Token usage for the final status [46], summed from the session record written in
# step 4. A missing or unparseable record, a jq failure or out-of-range numbers mean no
# usage; never a failed job. It comes after the PR lookup so it can't use up that time.
# The limits are the API's (MAX_USAGE_TOKENS, MAX_COST in drella/app.py), which would
# reject the whole status otherwise.
LIB=${DRELLA_LIB:-/usr/local/lib/drella-job}
USAGE=""
if [ "$AGENT" = claude-code ]; then
  [ -f "$OUT/session.jsonl" ] && USAGE=$(within 20 jq -c -R -n -f "$LIB/usage-claude-code.jq" "$OUT/session.jsonl" 2>/dev/null | tail -n 1)
else
  [ -f "$OUT/session.json" ] && USAGE=$(within 20 jq -c -f "$LIB/usage-opencode.jq" "$OUT/session.json" 2>/dev/null | tail -n 1)
fi
jq -e 'type == "object" and
  ([.[] | select(type != "number" or . < 0)] | length == 0) and
  ([to_entries[] | select(.key != "cost_usd") | .value | select(. != floor or . > 1e13)] | length == 0) and
  ((.cost_usd // 0) <= 100000)' <<<"${USAGE:-null}" >/dev/null 2>&1 || USAGE=""
[ -n "$USAGE" ] && log "usage: $USAGE"

# -- 5. report -----------------------------------------------------------------

# Told to stop during step 4 counts too: the job didn't get to finish normally.
reason=$(failure)
if [ -n "$reason" ]; then
  finish failed "$reason${pr:+; PR: $pr}$diff_note"
elif [ -z "$REPO" ] || [ -n "$REPORT" ]; then
  # The agent's results are files in /out; the transcript and session are ours, and
  # so is the diff of a repo job. Counts exactly what upload_outputs uploads
  # (is_output).
  results=0
  for f in "$OUT"/*; do
    is_output "$f" || continue
    case ${f##*/} in
      transcript.txt|session.json|session.jsonl) ;;
      diff.patch) [ -n "$REPO" ] || results=$((results + 1)) ;;
      *) results=$((results + 1)) ;;
    esac
  done
  if [ "$results" -gt 0 ]; then
    finish succeeded "done$diff_note"
  else
    finish failed "the agent wrote no outputs to $OUT"
  fi
elif [ -n "$FIX_PR" ] && [ -z "$pr" ] && [ -n "$pr_lookup_failed" ]; then
  finish failed "couldn't check whether the agent pushed to $PR_BRANCH (git ls-remote failed or timed out)$diff_note"
elif [ -n "$FIX_PR" ] && [ -z "$pr" ]; then
  finish failed "the agent didn't push to PR #$FIX_PR's branch $PR_BRANCH$diff_note"
elif [ -n "$FIX_PR" ]; then
  # Telling the PR's readers is a courtesy; failing to doesn't fail the job.
  within 20 gh pr comment "$FIX_PR" --body "Updated by Drella job $DRELLA_JOB_ID." >/dev/null 2>&1 \
    || log "couldn't comment on PR #$FIX_PR"
  finish succeeded "$pr$diff_note"
elif [ -z "$pr" ] && [ -n "$pr_lookup_failed" ]; then
  finish failed "couldn't check for a pull request (gh pr list failed or timed out)$diff_note"
elif [ -z "$pr" ]; then
  finish failed "the agent didn't open a pull request$diff_note"
else
  within 20 gh pr merge "$pr" --auto --squash >/dev/null 2>&1 || log "couldn't turn on auto-merge for $pr"
  finish succeeded "$pr$diff_note"
fi
